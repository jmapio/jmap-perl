# Settings for docker-compose.yml. Copy this file to .env and fill it in:
#
#   cp .env.example .env
#
# .env holds secrets: git ignores it and it is kept out of the image.
# A variable that is empty or commented out takes its default.
# SETUP.md describes every variable.

# --- Required ---------------------------------------------------------------

# Public URL clients reach the proxy at, i.e. your TLS reverse proxy.
# Used in JMAP session URLs and for the OAuth redirect URI ($BASEURL/cb/oauth).
BASEURL=https://jmap.example.com

# 256-bit AES key (64 hex characters) that encrypts stored passwords and
# OAuth tokens. Generate one with:  openssl rand -hex 32
# Required: left empty, the proxy will not start (unless
# JMAP_ALLOW_PLAINTEXT_CREDENTIALS=1, for a test server). Keep a copy outside
# the data volume: losing the key means losing every stored credential.
JMAP_SECRET_KEY=

# --- Host ports (used by docker-compose.yml only) ---------------------------

# Host port of the JMAP endpoint; point your reverse proxy at it.
JMAP_PUBLISH_PORT=9000
# Host port of the management API and dashboard (bound to 127.0.0.1 only).
JMAP_MGMT_PUBLISH_PORT=8080

# --- Sign-up ----------------------------------------------------------------

# Set to 1 to stop new accounts from being created via /signup, /signup_jmap
# and /cb/oauth. Existing accounts can still re-authenticate, and the
# management API can still add accounts. Empty leaves sign-up open.
JMAP_DISABLE_SIGNUP=

# --- OAuth2 -----------------------------------------------------------------

# Gmail: an OAuth client of type "web application" in Google Cloud Console,
# with $BASEURL/cb/oauth as redirect URI and the Gmail, CalDAV and Google
# Contacts CardDAV APIs enabled (SETUP.md, "OAuth2 Setup").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fastmail uses PKCE, so there is no secret. Empty uses a built-in client ID.
FASTMAIL_CLIENT_ID=

# --- OpenBao / Vault Transit (alternative to JMAP_SECRET_KEY) ---------------

# JMAP_OPENBAO_ADDR=http://openbao:8200
# Either a static token:
# JMAP_OPENBAO_TOKEN=
# or AppRole (recommended):
# JMAP_OPENBAO_ROLE_ID=
# JMAP_OPENBAO_SECRET_ID=
# JMAP_OPENBAO_MOUNT=transit
# JMAP_OPENBAO_KEY=jmap-credentials

# --- Tuning (defaults shown) ------------------------------------------------

# Seconds between background IMAP/CalDAV/CardDAV syncs.
# JMAP_SYNC_INTERVAL=30
# Seconds an account's worker process may sit idle before it is stopped.
# JMAP_IDLE_TIMEOUT=300
# Seconds without data before an IMAP connection counts as dead.
# JMAP_IMAP_TIMEOUT=120
# Largest file in bytes that FileNode holds in memory (256 MiB).
# JMAP_FILES_MAX_BYTES=268435456
# File-descriptor limit; by default the container's hard limit.
# JMAP_NOFILE=65536

# --- Debugging --------------------------------------------------------------

# Logs full JMAP request and response bodies, credentials included.
# Never leave this on in production.
# JMAP_DEBUG=1
